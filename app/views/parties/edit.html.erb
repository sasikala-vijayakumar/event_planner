<div class="max-w-2xl mx-auto mt-10 p-6 bg-white shadow-md rounded-lg">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Edit Party</h1>

  <%= form_with(model: @party, local: true, class: "space-y-6") do |form| %>
    <!-- Title -->
    <div>
      <%= form.label :title, class: "block text-gray-700 font-medium mb-2" %>
      <%= form.text_field :title, class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400" %>
    </div>

    <!-- Date & Time -->
    <div>
      <%= form.label :date_time, "Date & Time", class: "block text-gray-700 font-medium mb-2" %>
      <%= form.datetime_select :date_time, class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400" %>
    </div>

    <!-- Description -->
    <div>
      <%= form.label :description, class: "block text-gray-700 font-medium mb-2" %>
      <%= form.text_area :description, rows: 4, class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400" %>
    </div>

    <!-- Buttons -->
    <div class="flex gap-4">
      <%= form.submit "Update Party", class: "px-6 py-2 bg-green-600 hover:bg-green-700 text-white rounded-md font-medium transition" %>
      <%= link_to "Cancel", party_path(@party), class: "px-6 py-2 bg-gray-200 hover:bg-gray-300 rounded-md font-medium transition" %>
    </div>
  <% end %>
</div>
