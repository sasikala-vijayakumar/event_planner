<div class="max-w-3xl mx-auto mt-12 p-6 bg-white shadow-xl rounded-2xl space-y-10">
  
  <!-- Back Button -->
  <div>
    <%= link_to "← Back to Parties", parties_path, class: "inline-block px-4 py-2 bg-gray-300 hover:bg-gray-400 text-gray-800 rounded-lg font-medium transition" %>
  </div>

  <!-- Party Details -->
  <div class="space-y-2">
    <h1 class="text-3xl font-bold text-gray-800"><%= @party.title %></h1>
    <p class="text-gray-700"><strong>Date & Time:</strong> <%= @party.date_time.strftime("%B %d, %Y %I:%M %p") %></p>
    <p class="text-gray-700"><strong>Description:</strong> <%= @party.description.presence || "No description" %></p>
  </div>

  <hr class="border-gray-300">

  <!-- Attendees List -->
  <div class="space-y-4">
    <h2 class="text-2xl font-semibold text-gray-800">Attendees</h2>
    <ul class="space-y-3">
      <% @party.attendees.each do |attendee| %>
        <% next unless attendee.persisted? %>
        <li class="flex justify-between items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
          <div class="text-gray-700">
            <span class="font-medium"><%= attendee.full_name %></span> - 
            <span class="text-gray-600"><%= attendee.email %></span> - 
            <span class="text-gray-600"><%= attendee.phone %></span>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <hr class="border-gray-300">

  <!-- Add Attendee Form -->
  <div class="space-y-4">
    <h3 class="text-xl font-semibold text-gray-800">Add an Attendee</h3>
    <%= form_with(model: [@party, @attendee], local: true, class: "space-y-4") do |form| %>
      <div>
        <%= form.label :full_name, class: "block text-gray-700 font-medium mb-1" %>
        <%= form.text_field :full_name, class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400 transition" %>
      </div>
      <div>
        <%= form.label :email, class: "block text-gray-700 font-medium mb-1" %>
        <%= form.email_field :email, class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400 transition" %>
      </div>
      <div>
        <%= form.label :phone, class: "block text-gray-700 font-medium mb-1" %>
        <%= form.telephone_field :phone, class: "w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400 transition" %>
      </div>
      <div class="mt-2">
        <%= form.submit "Add Attendee", class: "px-6 py-2 bg-green-500 hover:bg-green-600 text-white rounded-md font-medium transition shadow-md hover:shadow-lg" %>
      </div>
    <% end %>
  </div>

</div>
