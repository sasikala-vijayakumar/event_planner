<%= form_with model: @party, local: true, class: "space-y-6" do |form| %>

  <% if @party.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 rounded-lg mb-4">
      <h2 class="font-semibold mb-2">Please fix the following errors:</h2>
      <ul class="list-disc list-inside">
        <% @party.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Party Title -->
  <div>
    <%= form.label :title, "Party Title", class: "block mb-2 font-semibold text-gray-700" %>
    <%= form.text_field :title, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition", required: true %>
  </div>

  <!-- Date & Time -->
  <div>
    <%= form.label :date_time, "Date & Time", class: "block mb-2 font-semibold text-gray-700" %>
    <%= form.datetime_local_field :date_time, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition", required: true %>
  </div>

  <!-- Description -->
  <div>
    <%= form.label :description, "Description (Optional)", class: "block mb-2 font-semibold text-gray-700" %>
    <%= form.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" %>
  </div>

  <!-- Buttons -->
  <div class="flex justify-end gap-4 mt-4">
    <%= link_to "Cancel", parties_path, class: "px-5 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg font-medium transition" %>
    <%= form.submit "Create Party", class: "px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition shadow-md hover:shadow-lg" %>
  </div>

<% end %>
