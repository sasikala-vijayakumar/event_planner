<h1>All Parties</h1>

<table class="table-auto w-full">
  <thead>
    <tr>
      <th>Title</th>
      <th>Date & Time</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @parties.each do |party| %>
      <tr>
        <td><%= party.title %></td>
        <td><%= party.date_time.strftime("%B %d, %Y %I:%M %p") %></td>
        <td class="flex gap-2">
          <%= link_to "View", party_path(party), class: "px-3 py-1 bg-blue-500 text-white rounded" %>
          <%= link_to "Edit", edit_party_path(party), class: "px-3 py-1 bg-green-500 text-white rounded" %>
          <%= link_to "Delete", party_path(party), method: :delete, data: { confirm: "Are you sure you want to delete this party?" }, class: "px-3 py-1 bg-red-500 text-white rounded" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New Party", new_party_path, class: "mt-4 inline-block px-4 py-2 bg-gray-700 text-white rounded" %>
